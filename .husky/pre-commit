echo "🔍 Running pre-commit checks..."
echo ""

# Run lint-staged (lint + format staged files)
npx lint-staged
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Lint/format check failed. Please fix the errors above and try again."
  exit 1
fi

# Run full build to catch type errors
echo ""
echo "🔨 Running build check..."
npm run build
BUILD_EXIT=$?

if [ $BUILD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Build failed. Please fix the errors above and try again."
  exit 1
fi

echo ""
echo "✅ All checks passed. Committing..."
